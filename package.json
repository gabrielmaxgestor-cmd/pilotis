{
  "name": "pilotis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.js",
    "build": "npm run lint && vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "preview": "vite preview",
    "migrate:compliance": "tsx scripts/migrateComplianceAttachments.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/domain/__tests__/*.test.ts\" && node --test \"tests/*.mjs\""
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "read-excel-file": "^9.3.20",
    "vite": "^8.3.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "@types/express": "^4.17.21"
  }
}
