# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model ID used server-side by /api/ai/chat (default: gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_COMPANY_EMAIL: Corporate email allowed to sign in (must match companyEmail() in firestore.rules).
VITE_COMPANY_EMAIL="empresa@pilotis.com.br"

# COMPANY_EMAIL: Server-side authorized company email verified in /api/ai/chat (falls back to VITE_COMPANY_EMAIL).
COMPANY_EMAIL="empresa@pilotis.com.br"

