rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Report content, approvals and token hashes are handled exclusively by the Node backend.
    match /projects/{id}/workReports/{document=**} {
      allow read, write: if false;
    }
    match /projects/{id}/clientApprovals/{document=**} {
      allow read, write: if false;
    }
    match /workReportShares/{document=**} {
      allow read, write: if false;
    }

    // AI conversations are accessible only through the authenticated Node backend.
    match /conversasIA/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Ponto único de configuração do e-mail autorizado da empresa
    // Deve coincidir exatamente com COMPANY_EMAIL / VITE_COMPANY_EMAIL em src/config/companyAuth.ts
    function companyEmail() {
      return 'gabrielmaxgestor@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() == companyEmail();
    }

    function isBoundedList() {
      return request.query.limit != null && request.query.limit <= 201;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidActor(v) {
      return v is string && v in ['Sócio', 'Responsável administrativo'];
    }

    function isValidStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function isValidNonEmptyStr(v, maxLen) {
      return v is string && v.size() >= 1 && v.size() <= maxLen;
    }

    function isValidNum(v) {
      return v is int || v is float;
    }

    function isValidNonNegNum(v) {
      return isValidNum(v) && v >= 0;
    }

    function isValidStringList(arr, maxItems, maxItemLen) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= maxItemLen));
    }

    function hasAuditFields(data) {
      return data.ownerUid == request.auth.uid
        && isValidId(data.ownerUid)
        && isValidActor(data.createdBy)
        && isValidActor(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validWhatsAppTemplates(templates) {
      let models = ['installmentDue', 'installmentOverdue', 'material', 'milestone', 'testimonial'];
      return templates is map && templates.keys().hasAll(models) && templates.keys().hasOnly(models)
        && isValidNonEmptyStr(templates.installmentDue, 500) && isValidNonEmptyStr(templates.installmentOverdue, 500)
        && isValidNonEmptyStr(templates.material, 500) && isValidNonEmptyStr(templates.milestone, 500)
        && isValidNonEmptyStr(templates.testimonial, 500);
    }

    function isValidCompanySettings(data) {
      return data.keys().hasAll(['ownerUid', 'companyName', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerUid', 'companyName', 'cnpj', 'fiscalAddress', 'city', 'email', 'phone',
          'accentColor', 'logoDataUrl', 'pdfShowLogo', 'popPdfHeader', 'popPdfFooter', 'whatsappTemplates', 'inssRate', 'fgtsRate', 'vacationRate',
          'thirteenthRate', 'targetMarginPct', 'taxParamsEffectiveDate', 'taxParamsSource',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.companyName, 120)
        && (!('cnpj' in data) || isValidStr(data.cnpj, 24))
        && (!('fiscalAddress' in data) || isValidStr(data.fiscalAddress, 240))
        && (!('city' in data) || isValidStr(data.city, 80))
        && (!('email' in data) || isValidStr(data.email, 120))
        && (!('phone' in data) || isValidStr(data.phone, 40))
        && (!('accentColor' in data) || isValidStr(data.accentColor, 20))
        && (!('logoDataUrl' in data) || isValidStr(data.logoDataUrl, 200000))
        && (!('pdfShowLogo' in data) || data.pdfShowLogo is bool)
        && (!('popPdfHeader' in data) || isValidStr(data.popPdfHeader, 120))
        && (!('popPdfFooter' in data) || isValidStr(data.popPdfFooter, 120))
        && (!('whatsappTemplates' in data) || validWhatsAppTemplates(data.whatsappTemplates))
        && (!('inssRate' in data) || isValidNonNegNum(data.inssRate))
        && (!('fgtsRate' in data) || isValidNonNegNum(data.fgtsRate))
        && (!('vacationRate' in data) || isValidNonNegNum(data.vacationRate))
        && (!('thirteenthRate' in data) || isValidNonNegNum(data.thirteenthRate))
        && (!('targetMarginPct' in data) || (isValidNonNegNum(data.targetMarginPct) && data.targetMarginPct <= 100))
        && (!('taxParamsEffectiveDate' in data) || isValidStr(data.taxParamsEffectiveDate, 20))
        && (!('taxParamsSource' in data) || isValidStr(data.taxParamsSource, 120));
    }

    function isValidClient(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'origin', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'origin', 'referredBy', 'city', 'phone', 'email', 'notes', 'status',
          'referralsCount', 'testimonialStatus', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'archive', 'archiveAuditId'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.name, 140)
        && isValidStr(data.origin, 80)
        && data.status in ['Potencial', 'Ativo', 'Em garantia', 'Inativo']
        && (!('referredBy' in data) || isValidStr(data.referredBy, 140))
        && (!('city' in data) || isValidStr(data.city, 80))
        && (!('phone' in data) || isValidStr(data.phone, 40))
        && (!('email' in data) || isValidStr(data.email, 120))
        && (!('notes' in data) || isValidStr(data.notes, 1000))
        && (!('referralsCount' in data) || isValidNonNegNum(data.referralsCount))
        && (!('testimonialStatus' in data) || isValidStr(data.testimonialStatus, 60));
    }

    function isValidQuote(data) {
      return data.keys().hasAll([
        'ownerUid', 'code', 'clientId', 'clientName', 'title', 'type', 'totalValue', 'status',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'code', 'clientId', 'clientName', 'title', 'type', 'city', 'areaM2',
          'estimatedMonths', 'validityDays', 'description', 'origin', 'laborCost', 'subcontractCost',
          'equipmentCost', 'bdiCost', 'taxCost', 'pricingMarginPct', 'totalValue', 'downPaymentPct', 'installmentsCount',
          'probabilityPct', 'status', 'discardReason', 'lossReason', 'version', 'versionHistory',
          'contractSignStatus', 'contractSignedAt', 'contractAddenda', 'addendaTotalValue',
          'projectId', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'archive', 'archiveAuditId'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.code, 30)
        && isValidId(data.clientId)
        && isValidNonEmptyStr(data.clientName, 140)
        && isValidNonEmptyStr(data.title, 160)
        && data.type in ['Casa residencial', 'Reforma', 'Obra satélite']
        && isValidNonNegNum(data.totalValue)
        && data.status in ['Rascunho', 'Enviado', 'Em negociação', 'Ganho', 'Perdido', 'Descartado']
        && isValidStr(data.get('city', ''), 80)
        && isValidNonNegNum(data.get('areaM2', 0))
        && isValidNonNegNum(data.get('estimatedMonths', 0))
        && isValidNonNegNum(data.get('validityDays', 0))
        && isValidStr(data.get('description', ''), 1500)
        && isValidStr(data.get('origin', ''), 80)
        && isValidNonNegNum(data.get('laborCost', 0))
        && isValidNonNegNum(data.get('subcontractCost', 0))
        && isValidNonNegNum(data.get('equipmentCost', 0))
        && isValidNonNegNum(data.get('bdiCost', 0))
        && isValidNonNegNum(data.get('taxCost', 0))
        && (isValidNonNegNum(data.get('pricingMarginPct', 0)) && data.get('pricingMarginPct', 0) <= 99.99)
        && (isValidNonNegNum(data.get('downPaymentPct', 0)) && data.get('downPaymentPct', 0) <= 100)
        && (isValidNonNegNum(data.get('installmentsCount', 0)) && data.get('installmentsCount', 0) <= 36)
        && (isValidNonNegNum(data.get('probabilityPct', 0)) && data.get('probabilityPct', 0) <= 100)
        && isValidStr(data.get('discardReason', ''), 300)
        && isValidStr(data.get('lossReason', ''), 300)
        && isValidStr(data.get('version', ''), 20)
        && (!('versionHistory' in data) || isValidStringList(data.versionHistory, 30, 400))
        && (!('contractSignStatus' in data) || data.contractSignStatus in ['Não gerado', 'Aguardando assinatura', 'Assinado pelo cliente', 'Assinado pelas partes'])
        && isValidStr(data.get('contractSignedAt', ''), 20)
        && (!('contractAddenda' in data) || isValidStringList(data.contractAddenda, 30, 400))
        && isValidNum(data.get('addendaTotalValue', 0))
        && isValidStr(data.get('projectId', ''), 128);
    }

    function isValidProject(data) {
      return data.keys().hasAll([
        'ownerUid', 'name', 'type', 'contractValue', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'quoteId', 'clientId', 'clientName', 'type', 'contractKind', 'planningStatus', 'scheduleRevision', 'scheduleBaselineVersion', 'scheduleStageIds', 'customerMaterialIds', 'workInProgressLimit',
          'contractValue', 'contractPdf', 'downPaymentPct', 'installmentsCount', 'addendaTotalValue',
          'budgetedLabor', 'budgetedSubcontract', 'budgetedEquipment', 'budgetedBdi', 'budgetedTax',
          'startDate', 'baselineEndDate', 'forecastEndDate', 'status', 'contractSigned',
          'warrantyStartDate', 'closureDate', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'archive', 'archiveAuditId'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.name, 160)
        && data.type in ['Casa residencial', 'Reforma', 'Obra satélite']
        && (!('contractKind' in data) || data.contractKind in ['Principal', 'Satélite'])
        && (!('planningStatus' in data) || data.planningStatus in ['Aguardando modelo de cronograma', 'Cronograma criado'])
        && (!('scheduleStageIds' in data) || data.scheduleStageIds is list)
        && (!('scheduleBaselineVersion' in data) || (data.scheduleBaselineVersion is int && data.scheduleBaselineVersion >= 1))
        && (!('workInProgressLimit' in data) || (data.workInProgressLimit is int && data.workInProgressLimit >= 1 && data.workInProgressLimit <= 100))
        && (!('scheduleRevision' in data) || (data.scheduleRevision is int && data.scheduleRevision >= 0))
        && isValidNonNegNum(data.contractValue)
        && (!('contractPdf' in data) || (data.contractPdf is bytes && data.contractPdf.size() > 0 && data.contractPdf.size() <= 65536))
        && (!('downPaymentPct' in data) || (isValidNonNegNum(data.downPaymentPct) && data.downPaymentPct <= 100))
        && (!('installmentsCount' in data) || (isValidNonNegNum(data.installmentsCount) && data.installmentsCount <= 36))
        && (!('addendaTotalValue' in data) || isValidNum(data.addendaTotalValue))
        && data.status in ['Contratada', 'Em execução', 'Concluída']
        && (!('quoteId' in data) || isValidStr(data.quoteId, 128))
        && (!('clientId' in data) || isValidStr(data.clientId, 128))
        && (!('clientName' in data) || isValidStr(data.clientName, 140))
        && (!('budgetedLabor' in data) || isValidNonNegNum(data.budgetedLabor))
        && (!('budgetedSubcontract' in data) || isValidNonNegNum(data.budgetedSubcontract))
        && (!('budgetedEquipment' in data) || isValidNonNegNum(data.budgetedEquipment))
        && (!('budgetedBdi' in data) || isValidNonNegNum(data.budgetedBdi))
        && (!('budgetedTax' in data) || isValidNonNegNum(data.budgetedTax))
        && (!('startDate' in data) || isValidStr(data.startDate, 20))
        && (!('baselineEndDate' in data) || isValidStr(data.baselineEndDate, 20))
        && (!('forecastEndDate' in data) || isValidStr(data.forecastEndDate, 20))
        && (!('contractSigned' in data) || data.contractSigned is bool)
        && (!('warrantyStartDate' in data) || isValidStr(data.warrantyStartDate, 20))
        && (!('closureDate' in data) || isValidNonEmptyStr(data.closureDate, 10));
    }

    function isValidInstallment(data) {
      return data.keys().hasAll([
        'ownerUid', 'projectId', 'quoteId', 'clientId', 'number', 'label', 'dueDate', 'amount', 'status',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'projectId', 'projectName', 'quoteId', 'clientId', 'clientName',
          'number', 'label', 'dueDate', 'amount', 'status', 'invoiceStatus', 'receivedDate',
          'transactionId', 'receiptReversalAuditId', 'reminderMessageId', 'reminderSentAt', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidId(data.projectId)
        && isValidId(data.quoteId)
        && isValidId(data.clientId)
        && isValidNonNegNum(data.number)
        && isValidNonEmptyStr(data.label, 40)
        && isValidNonEmptyStr(data.dueDate, 20)
        && isValidNonNegNum(data.amount)
        && data.status in ['A vencer', 'Recebida']
        && (!('projectName' in data) || isValidStr(data.projectName, 160))
        && (!('clientName' in data) || isValidStr(data.clientName, 140))
        && (!('invoiceStatus' in data) || data.invoiceStatus in ['Emitida', 'A emitir', 'Não emitida', 'Não se aplica'])
        && (!('receivedDate' in data) || isValidStr(data.receivedDate, 20))
        && (!('receiptReversalAuditId' in data) || isValidId(data.receiptReversalAuditId))
        && (!('transactionId' in data) || isValidStr(data.transactionId, 128));
    }

    function isValidStage(data) {
      return data.keys().hasAll([
        'ownerUid', 'projectId', 'wbsCode', 'phase', 'name', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'projectId', 'wbsCode', 'phase', 'deliverable', 'name', 'responsible', 'durationWeeks',
          'startWeek', 'baselineStartWeek', 'baselineDurationWeeks', 'baselineBudgetedCost', 'progressPct', 'completedDate', 'budgetedCost',
          'popId', 'dependsOn', 'isMilestone', 'status', 'materialExpectedDate', 'delayCategory',
          'delayJustification', 'checklistCompleted', 'popReview', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidId(data.projectId)
        && isValidNonEmptyStr(data.wbsCode, 24)
        && isValidNonEmptyStr(data.phase, 100)
        && isValidNonEmptyStr(data.name, 140)
        && data.status in ['A fazer', 'Em andamento', 'Aguardando material', 'Em conferência', 'Concluída']
        && (!('responsible' in data) || isValidStr(data.responsible, 120))
        && (!('durationWeeks' in data) || isValidNonNegNum(data.durationWeeks))
        && (!('startWeek' in data) || isValidNonNegNum(data.startWeek))
        && (!('baselineStartWeek' in data) || isValidNonNegNum(data.baselineStartWeek))
        && (!('deliverable' in data) || isValidStr(data.deliverable, 120))
        && (!('baselineBudgetedCost' in data) || isValidNonNegNum(data.baselineBudgetedCost))
        && (!('baselineDurationWeeks' in data) || isValidNonNegNum(data.baselineDurationWeeks))
        && (!('progressPct' in data) || (isValidNonNegNum(data.progressPct) && data.progressPct <= 100))
        && (!('completedDate' in data) || (data.completedDate == '' ||
          (data.status == 'Concluída' && validMaterialDate(data.completedDate))))
        && (!('budgetedCost' in data) || isValidNonNegNum(data.budgetedCost))
        && (!('popId' in data) || isValidStr(data.popId, 128))
        && (!('dependsOn' in data) || isValidStringList(data.dependsOn, 10, 128))
        && (!('isMilestone' in data) || data.isMilestone is bool)
        && (!('materialExpectedDate' in data) || isValidStr(data.materialExpectedDate, 20))
        && (!('delayCategory' in data) || isValidStr(data.delayCategory, 60))
        && (!('delayJustification' in data) || isValidStr(data.delayJustification, 500))
        && (!('checklistCompleted' in data) || isValidStringList(data.checklistCompleted, 20, 200))
        && (data.get('popReview', null) == null || (
          data.status == 'Concluída' && data.popReview is map
          && data.popReview.keys().hasOnly(['popId', 'version', 'acceptanceCriteria'])
          && data.popReview.popId == data.popId && isValidId(data.popReview.popId)
          && isValidNonEmptyStr(data.popReview.version, 20)
          && isValidStringList(data.popReview.acceptanceCriteria, 20, 200)
        ));
    }

    function isValidDailyLog(data) {
      return data.keys().hasAll([
        'ownerUid', 'projectId', 'date', 'weather', 'activities', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'projectId', 'date', 'presentCount', 'weather', 'activities',
          'occurrences', 'photoNotes', 'presentTeam', 'photoIds', 'photoBackend', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidId(data.projectId)
        && isValidNonEmptyStr(data.date, 20)
        && data.weather in ['Sol', 'Chuva fraca', 'Chuva forte']
        && isValidNonEmptyStr(data.activities, 1500)
        && (!('presentCount' in data) || isValidNonNegNum(data.presentCount))
        && (!('occurrences' in data) || isValidStr(data.occurrences, 1000))
        && (!('photoNotes' in data) || isValidStringList(data.photoNotes, 10, 200))
        && (!('presentTeam' in data) || isValidStr(data.presentTeam, 500))
        && (!('photoIds' in data) || isValidStringList(data.photoIds, 6, 128))
        && (!('photoBackend' in data) || data.photoBackend in ['firestore', 'storage']);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
        'ownerUid', 'date', 'description', 'entryKind', 'category', 'projectId', 'amount', 'isForecast', 'status',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'date', 'dueDate', 'description', 'entryKind', 'category', 'projectId', 'projectName',
          'amount', 'isForecast', 'wasForecast', 'statementKey', 'status', 'invoiceStatus', 'paymentMethod', 'receiptRef', 'receiptFile', 'installmentLabel',
          'installmentId', 'quoteId', 'debtId', 'source', 'payrollEmployeeId', 'payrollPeriod',
          'payrollBase', 'payrollCharges', 'payrollProvisions',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.date, 20)
        && isValidNonEmptyStr(data.description, 200)
        && data.entryKind in ['income', 'expense', 'loan']
        && !(data.entryKind == 'income' && data.category == 'Empréstimo')
        && isValidNonEmptyStr(data.category, 60)
        && isValidNonEmptyStr(data.projectId, 128)
        && isValidNonNegNum(data.amount)
        && data.isForecast is bool
        && data.status in ['Recebido', 'Pago', 'A vencer', 'Não é receita']
        && (!('dueDate' in data) || isValidStr(data.dueDate, 20))
        && (!('projectName' in data) || isValidStr(data.projectName, 160))
        && (!('invoiceStatus' in data) || data.invoiceStatus in ['Emitida', 'A emitir', 'Não emitida', 'Não se aplica'])
        && (!('paymentMethod' in data) || isValidStr(data.paymentMethod, 60))
        && (!('receiptRef' in data) || isValidStr(data.receiptRef, 160))
        && (!('wasForecast' in data) || data.wasForecast is bool)
        && (!('payrollEmployeeId' in data) || isValidId(data.payrollEmployeeId))
        && (!('payrollPeriod' in data) || (data.payrollPeriod is string && data.payrollPeriod.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')))
        && (!('payrollBase' in data) || isValidNonNegNum(data.payrollBase))
        && (!('payrollCharges' in data) || isValidNonNegNum(data.payrollCharges))
        && (!('payrollProvisions' in data) || isValidNonNegNum(data.payrollProvisions))
        && (!('statementKey' in data) || isValidNonEmptyStr(data.statementKey, 512))
        && (!('receiptFile' in data) || (
          data.receiptFile is map
          && data.receiptFile.keys().hasOnly(['name', 'mimeType', 'content'])
          && isValidNonEmptyStr(data.receiptFile.name, 160)
          && data.receiptFile.mimeType in ['application/pdf', 'image/png', 'image/jpeg']
          && data.receiptFile.content is bytes
          && data.receiptFile.content.size() > 0
          && data.receiptFile.content.size() <= 716800
        ))
        && (!('installmentLabel' in data) || isValidStr(data.installmentLabel, 40))
        && (!('installmentId' in data) || isValidStr(data.installmentId, 128))
        && (!('quoteId' in data) || isValidStr(data.quoteId, 128))
        && (!('debtId' in data) || isValidStr(data.debtId, 128))
        && (!('source' in data) || data.source in ['manual', 'orcamento', 'planilha', 'extrato', 'folha']);
    }

    function isValidDebt(data) {
      return data.keys().hasAll([
        'ownerUid', 'creditor', 'debtType', 'principalBalance', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'creditor', 'debtType', 'principalBalance', 'monthlyCost', 'remainingInstallments',
          'nextDueDate', 'status', 'notes', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.creditor, 140)
        && data.debtType in ['Empréstimo bancário', 'Conta garantida', 'Tributo em atraso', 'Encargos trabalhistas', 'Outro']
        && isValidNonNegNum(data.principalBalance)
        && data.status in ['Em dia', 'Em uso', 'A parcelar', 'Quitada']
        && (!('monthlyCost' in data) || isValidNonNegNum(data.monthlyCost))
        && (!('remainingInstallments' in data) || isValidNonNegNum(data.remainingInstallments))
        && (!('nextDueDate' in data) || isValidStr(data.nextDueDate, 20))
        && (!('notes' in data) || isValidStr(data.notes, 500));
    }

    function isValidEmployee(data) {
      return data.keys().hasAll([
        'ownerUid', 'name', 'role', 'employmentType', 'baseSalary', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'role', 'employmentType', 'baseSalary', 'paymentMethod', 'startDate',
          'currentProjectId', 'currentProjectName', 'asoExpiry', 'nr18Expiry', 'nr35Expiry',
          'epiStatus', 'epiExpiry', 'onboardingStatus', 'onboardingStart', 'vacationPeriod', 'vacationScheduled',
          'vacationStart', 'vacationEnd', 'paymentMonth', 'paymentFrequency', 'occurrencesNote',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'archive', 'archiveAuditId'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.name, 140)
        && isValidNonEmptyStr(data.role, 80)
        && data.employmentType in ['CLT', 'PJ', 'Autônomo', 'Freelancer', 'Diarista', 'Informal', 'Sócio']
        && isValidNonNegNum(data.baseSalary)
        && (!('paymentMethod' in data) || isValidStr(data.paymentMethod, 60))
        && (!('startDate' in data) || isValidStr(data.startDate, 20))
        && (!('currentProjectId' in data) || isValidStr(data.currentProjectId, 128))
        && (!('currentProjectName' in data) || isValidStr(data.currentProjectName, 160))
        && (!('asoExpiry' in data) || isValidStr(data.asoExpiry, 20))
        && (!('nr18Expiry' in data) || isValidStr(data.nr18Expiry, 20))
        && (!('nr35Expiry' in data) || isValidStr(data.nr35Expiry, 20))
        && (!('epiStatus' in data) || data.epiStatus in ['Em dia', 'A repor', 'Pendente'])
        && (!('onboardingStatus' in data) || data.onboardingStatus in ['Concluída', 'Em andamento', 'Pendente'])
        && (!('vacationPeriod' in data) || isValidStr(data.vacationPeriod, 60))
        && (!('vacationScheduled' in data) || isValidStr(data.vacationScheduled, 60))
        && (!('paymentFrequency' in data) || data.paymentFrequency in ['monthly', 'oneOff'])
        && (!('paymentMonth' in data) || isValidStr(data.paymentMonth, 7))
        && (!('vacationStart' in data) || isValidStr(data.vacationStart, 10))
        && (!('vacationEnd' in data) || isValidStr(data.vacationEnd, 10))
        && (!('onboardingStart' in data) || isValidStr(data.onboardingStart, 10))
        && (!('epiExpiry' in data) || isValidStr(data.epiExpiry, 10))
        && (!('occurrencesNote' in data) || isValidStr(data.occurrencesNote, 1000));
    }

    function isValidAllocation(data) {
      return data.keys().hasAll([
        'ownerUid', 'employeeId', 'projectId', 'weekStart', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'employeeId', 'employeeName', 'projectId', 'projectName', 'weekStart', 'stageId', 'effectiveFrom', 'status',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidId(data.employeeId)
        && isValidNonEmptyStr(data.projectId, 128)
        && isValidNonEmptyStr(data.weekStart, 20)
        && (!('effectiveFrom' in data) || isValidNonEmptyStr(data.effectiveFrom, 10))
        && data.status in ['Obra', 'Férias']
        && (data.get('stageId', '') == '' || (
          data.status == 'Obra' && isValidId(data.stageId)
          && get(/databases/$(database)/documents/stages/$(data.stageId)).data.projectId == data.projectId
          && get(/databases/$(database)/documents/stages/$(data.stageId)).data.ownerUid == request.auth.uid
        ))
        && (!('employeeName' in data) || isValidStr(data.employeeName, 140))
        && (!('projectName' in data) || isValidStr(data.projectName, 160));
    }

    function hasPopContent(data) {
      return isValidNonEmptyStr(data.title, 160)
        && isValidNonEmptyStr(data.serviceType, 80)
        && (!('linkedStagePhase' in data) || isValidStr(data.linkedStagePhase, 80))
        && (!('objective' in data) || isValidStr(data.objective, 1000))
        && (!('materialsAndEpi' in data) || isValidStr(data.materialsAndEpi, 1000))
        && (!('tools' in data) || isValidStr(data.tools, 1000))
        && (!('protectiveEquipment' in data) || isValidStr(data.protectiveEquipment, 1000))
        && (!('steps' in data) || isValidStringList(data.steps, 20, 300))
        && (!('acceptanceCriteria' in data) || isValidStringList(data.acceptanceCriteria, 20, 200))
        && (!('usedInOnboarding' in data) || data.usedInOnboarding is bool)
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 8));
    }

    function hasPopApproval(data) {
      return (!('approvedBy' in data) || isValidActor(data.approvedBy))
        && (!('publishedOn' in data) || isValidNonEmptyStr(data.publishedOn, 10))
        && (!('changeSummary' in data) || isValidNonEmptyStr(data.changeSummary, 500));
    }

    function isValidPop(data) {
      return data.keys().hasOnly([
          'ownerUid', 'title', 'serviceType', 'version', 'linkedStagePhase', 'objective', 'materialsAndEpi',
          'tools', 'protectiveEquipment', 'steps', 'acceptanceCriteria', 'status', 'usedInOnboarding', 'attachments',
          'revision', 'publicationNumber', 'approvedBy', 'publishedOn', 'changeSummary', 'draft',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data) && hasPopContent(data) && hasPopApproval(data)
        && isValidNonEmptyStr(data.version, 20) && data.status in ['Vigente', 'Em revisão']
        && (!('revision' in data) || (data.revision is int && data.revision > 0))
        && (!('publicationNumber' in data) || (data.publicationNumber is int && data.publicationNumber >= 0))
        && (data.get('draft', null) == null || (data.status == 'Em revisão' && data.draft is map
          && data.draft.keys().hasOnly(['title', 'serviceType', 'linkedStagePhase', 'objective', 'materialsAndEpi',
             'tools', 'protectiveEquipment', 'steps', 'acceptanceCriteria', 'usedInOnboarding', 'attachments'])
          && hasPopContent(data.draft)));
    }

    function isValidComplianceItem(data, itemId) {
      return data.keys().hasAll([
        'ownerUid', 'kind', 'title', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'kind', 'title', 'category', 'projectId', 'projectName', 'competence',
          'dueDate', 'issuedDate', 'fileName', 'attachmentId', 'mandatory', 'status', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && data.kind in ['Obrigação', 'Certidão', 'Documento de obra', 'Licitação']
        && isValidNonEmptyStr(data.title, 160)
        && data.status in ['Em dia', 'Válida', 'Anexado', 'Vence em breve', 'Pendente', 'Parcial']
        && (!('category' in data) || isValidStr(data.category, 80))
        && (!('projectId' in data) || isValidStr(data.projectId, 128))
        && (!('projectName' in data) || isValidStr(data.projectName, 160))
        && (!('competence' in data) || isValidStr(data.competence, 40))
        && (!('dueDate' in data) || isValidStr(data.dueDate, 20))
        && (!('issuedDate' in data) || isValidStr(data.issuedDate, 20))
        && (!('fileName' in data) || isValidStr(data.fileName, 160))
        && (!('attachmentId' in data) || (isValidId(data.attachmentId)
          && getAfter(/databases/$(database)/documents/complianceFiles/$(data.attachmentId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/complianceFiles/$(data.attachmentId)).data.itemId == itemId
          && !('removedAt' in getAfter(/databases/$(database)/documents/complianceFiles/$(data.attachmentId)).data)))
        && (!('mandatory' in data) || data.mandatory is bool)
        && (!('notes' in data) || isValidStr(data.notes, 500));
    }

    function isValidTender(data) {
      return data.keys().hasAll([
        'ownerUid', 'agency', 'objectTitle', 'openingDate', 'estimatedValue', 'status',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'agency', 'objectTitle', 'openingDate', 'estimatedValue', 'status', 'notes',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidNonEmptyStr(data.agency, 140)
        && isValidNonEmptyStr(data.objectTitle, 200)
        && isValidNonEmptyStr(data.openingDate, 20)
        && isValidNonNegNum(data.estimatedValue)
        && data.status in ['Acompanhando', 'Em preparo', 'Documentos pendentes', 'Enviado', 'Encerrado']
        && (!('notes' in data) || isValidStr(data.notes, 500));
    }

    function isValidWarrantyCall(data) {
      return data.keys().hasAll([
        'ownerUid', 'projectId', 'projectName', 'description', 'status',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'projectId', 'projectName', 'description', 'openedDate', 'deadlineDate', 'cost',
          'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && hasAuditFields(data)
        && isValidId(data.projectId)
        && isValidNonEmptyStr(data.projectName, 160)
        && isValidNonEmptyStr(data.description, 400)
        && data.status in ['Aberto', 'Em atendimento', 'Resolvido']
        && (!('openedDate' in data) || isValidStr(data.openedDate, 20))
        && (!('deadlineDate' in data) || isValidStr(data.deadlineDate, 20))
        && (!('cost' in data) || isValidNonNegNum(data.cost));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['ownerUid', 'registeredBy', 'action', 'entityType', 'summary', 'createdAt'])
        && data.keys().hasOnly([
          'ownerUid', 'registeredBy', 'action', 'entityType', 'summary', 'beforeValue', 'afterValue', 'createdAt', 'entityId'
        ])
        && data.ownerUid == request.auth.uid
        && isValidId(data.ownerUid)
        && isValidActor(data.registeredBy)
        && data.action in ['Criação', 'Atualização', 'Exclusão', 'Importação']
        && isValidNonEmptyStr(data.entityType, 60)
        && isValidNonEmptyStr(data.summary, 240)
        && (!('entityId' in data) || isValidId(data.entityId))
        && data.createdAt is timestamp
        && (!('beforeValue' in data) || isValidStr(data.beforeValue, 16000))
        && (!('afterValue' in data) || isValidStr(data.afterValue, 16000));
    }

    match /companySettings/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidCompanySettings(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) && isValidCompanySettings(incoming())
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    function notDeleted(entity, id) {
      let key = entity + '_' + id;
      return id in ['', 'Empresa', 'Sem obra'] || !existsAfter(/databases/$(database)/documents/recordTombstones/$(key));
    }

    function validNewReference(data, entity, field) {
      return notDeleted(entity, data.get(field, ''));
    }

    function validChangedReference(entity, field) {
      return incoming().get(field, '') == existing().get(field, '')
        || validNewReference(incoming(), entity, field);
    }

    function currentAudit(auditId, entity, id, actor) {
      let audit = getAfter(/databases/$(database)/documents/auditLogs/$(auditId)).data;
      return audit.ownerUid == request.auth.uid && audit.entityType == entity && audit.entityId == id
        && audit.registeredBy == actor && audit.action == 'Atualização' && audit.createdAt == request.time;
    }

    function archivalChange(entity, id) {
      let before = existing().get('archive', null);
      let archive = incoming().get('archive', null);
      let auditId = incoming().get('archiveAuditId', '');
      return incoming().diff(existing()).affectedKeys().hasOnly(['archive', 'archiveAuditId', 'updatedAt', 'updatedBy'])
        && isValidActor(incoming().updatedBy) && incoming().updatedAt == request.time
        && isValidId(auditId) && currentAudit(auditId, entity, id, incoming().updatedBy)
        && ((before == null && archive is map
          && archive.keys().hasAll(['at', 'by']) && archive.keys().hasOnly(['at', 'by'])
          && archive.at == request.time && archive.by == incoming().updatedBy)
          || (before is map && !('archive' in incoming())));
    }

    match /clients/{clientId} {
      allow get: if isValidId(clientId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(clientId) && isSignedIn() && isValidClient(incoming())
        && notDeleted('clients', clientId)
        && !incoming().keys().hasAny(['archive', 'archiveAuditId']) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(clientId) && isSignedIn()
        && existing().ownerUid == request.auth.uid
        && !('archive' in existing()) && !('archive' in incoming())
        && incoming().get('archiveAuditId', '') == existing().get('archiveAuditId', '')
        && isValidClient(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow update: if isValidId(clientId) && isOwner(existing().ownerUid)
        && archivalChange('clients', clientId);
      allow delete: if false;
    }

    function isInstallmentWhatsAppModel(model) {
      return model in ['installmentDue', 'installmentOverdue'];
    }

    function whatsappHistoryOwner(clientId) {
      return isValidId(clientId) && isOwner(get(/databases/$(database)/documents/clients/$(clientId)).data.ownerUid);
    }

    function whatsappParcelMatches(clientId, messageId, data) {
      let parcel = getAfter(/databases/$(database)/documents/parcelas/$(data.sourceId)).data;
      return parcel.ownerUid == request.auth.uid && parcel.clientId == clientId && parcel.projectId == data.projectId
        && parcel.status == 'A vencer' && parcel.reminderMessageId == messageId && parcel.reminderSentAt == request.time;
    }

    function whatsappMaterialMatches(data) {
      let row = get(/databases/$(database)/documents/customerMaterials/$(data.sourceId)).data;
      return row.ownerUid == request.auth.uid && row.projectId == data.projectId && row.status != 'Entregue';
    }

    function whatsappMilestoneMatches(data) {
      let row = get(/databases/$(database)/documents/stages/$(data.sourceId)).data;
      return row.ownerUid == request.auth.uid && row.projectId == data.projectId && row.get('isMilestone', false) == true;
    }

    function whatsappSourceBelongsToClient(clientId, messageId, data) {
      let project = get(/databases/$(database)/documents/projects/$(data.projectId)).data;
      return project.ownerUid == request.auth.uid && project.clientId == clientId && !('archive' in project)
        && (isInstallmentWhatsAppModel(data.model) ? whatsappParcelMatches(clientId, messageId, data)
          : data.model == 'testimonial' ? project.status == 'Concluída' && data.projectId == data.sourceId
          : project.status != 'Concluída' && (data.model == 'material' ? whatsappMaterialMatches(data)
            : whatsappMilestoneMatches(data)));
    }

    match /clients/{clientId}/whatsappHistory/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn() && whatsappHistoryOwner(clientId);
      allow list: if isBoundedList() && isSignedIn() && whatsappHistoryOwner(clientId);
      allow create: if isValidId(messageId) && isSignedIn() && whatsappHistoryOwner(clientId)
        && !('archive' in get(/databases/$(database)/documents/clients/$(clientId)).data)
        && incoming().keys().hasOnly(['ownerUid', 'model', 'projectId', 'sourceId', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && hasAuditFields(incoming()) && incoming().createdBy == incoming().updatedBy
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && isValidId(incoming().projectId) && isValidId(incoming().sourceId)
        && incoming().model in ['installmentDue', 'installmentOverdue', 'material', 'milestone', 'testimonial']
        && whatsappSourceBelongsToClient(clientId, messageId, incoming());
      allow update, delete: if false;
    }

    function confirmedProjectMatches(quoteId, quote) {
      let project = getAfter(/databases/$(database)/documents/projects/$(quote.projectId)).data;
      return project.ownerUid == request.auth.uid
        && project.quoteId == quoteId
        && project.clientId == quote.clientId
        && project.contractValue == quote.totalValue
        && project.status == 'Contratada'
        && project.planningStatus == 'Aguardando modelo de cronograma'
        && project.contractPdf is bytes;
    }

    function confirmationClientBelongsToCompany(clientId) {
      let client = getAfter(/databases/$(database)/documents/clients/$(clientId));
      return client != null && client.data.ownerUid == request.auth.uid && !('archive' in client.data);
    }

    function isValidQuoteConfirmation(quoteId, quote, before) {
      return before.get('projectId', '') == ''
        && before.status in ['Rascunho', 'Enviado', 'Em negociação', 'Ganho']
        // The stored quote's unchanged fields were validated when they were saved.
        && quote.diff(before).affectedKeys().hasOnly([
          'status', 'probabilityPct', 'projectId', 'clientId', 'clientName',
          'downPaymentPct', 'installmentsCount', 'contractSignStatus', 'updatedBy', 'updatedAt'
        ])
        && quote.status == 'Ganho'
        && quote.probabilityPct == 100
        && isValidId(quote.projectId)
        && isValidId(quote.clientId)
        && isValidNonEmptyStr(quote.clientName, 140)
        && isValidNum(quote.totalValue) && quote.totalValue > 0
        && isValidNonNegNum(quote.downPaymentPct) && quote.downPaymentPct <= 100
        && quote.installmentsCount is int && quote.installmentsCount >= 1 && quote.installmentsCount <= 36
        && quote.contractSignStatus in ['Aguardando assinatura', 'Assinado pelo cliente', 'Assinado pelas partes']
        && (before.status != 'Ganho' || (
          quote.clientId == before.clientId
          && (before.get('downPaymentPct', null) == null || quote.downPaymentPct == before.downPaymentPct)
          && (before.get('installmentsCount', null) == null || quote.installmentsCount == before.installmentsCount)
        ))
        && isValidActor(quote.updatedBy)
        && confirmationClientBelongsToCompany(quote.clientId)
        && confirmedProjectMatches(quoteId, quote);
    }

    match /quotes/{quoteId} {
      allow get: if isValidId(quoteId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(quoteId) && isSignedIn() && isValidQuote(incoming())
        && notDeleted('quotes', quoteId)
        && !incoming().keys().hasAny(['archive', 'archiveAuditId']) && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && confirmationClientBelongsToCompany(incoming().clientId);
      allow update: if isValidId(quoteId) && isSignedIn()
        && (incoming().clientId == existing().clientId || confirmationClientBelongsToCompany(incoming().clientId))
        && existing().ownerUid == request.auth.uid
        && !('archive' in existing()) && !('archive' in incoming())
        && incoming().get('archiveAuditId', '') == existing().get('archiveAuditId', '')
        && incoming().updatedAt == request.time
        && (incoming().get('projectId', '') == existing().get('projectId', '')
          ? (
            isValidQuote(incoming())
            && incoming().ownerUid == existing().ownerUid
            && incoming().createdAt == existing().createdAt
            && incoming().createdBy == existing().createdBy
            && (
              existing().status != 'Ganho'
              || (
                incoming().status == 'Ganho'
                && incoming().totalValue == existing().totalValue
                && (!('laborCost' in existing()) || incoming().laborCost == existing().laborCost)
                && (!('subcontractCost' in existing()) || incoming().subcontractCost == existing().subcontractCost)
                && (!('equipmentCost' in existing()) || incoming().equipmentCost == existing().equipmentCost)
                && (!('bdiCost' in existing()) || incoming().bdiCost == existing().bdiCost)
                && (!('taxCost' in existing()) || incoming().taxCost == existing().taxCost)
                && incoming().get('pricingMarginPct', null) == existing().get('pricingMarginPct', null)
                && (existing().get('projectId', '') == '' || incoming().diff(existing()).affectedKeys().hasOnly([
                  'contractSignStatus', 'contractSignedAt', 'contractAddenda', 'addendaTotalValue', 'updatedBy', 'updatedAt'
                ]))
              )
            )
          )
          : isValidQuoteConfirmation(quoteId, incoming(), existing()));
      allow update: if isValidId(quoteId) && isOwner(existing().ownerUid)
        && archivalChange('quotes', quoteId);
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid);
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(projectId) && isSignedIn() && isValidProject(incoming())
        && notDeleted('projects', projectId)
        && validNewReference(incoming(), 'clients', 'clientId')
        && validNewReference(incoming(), 'quotes', 'quoteId')
        && !incoming().keys().hasAny(['archive', 'archiveAuditId', 'customerMaterialIds']) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId) && isSignedIn()
        && validChangedReference('clients', 'clientId')
        && validChangedReference('quotes', 'quoteId')
        && existing().ownerUid == request.auth.uid
        && !('archive' in existing()) && !('archive' in incoming())
        && incoming().get('archiveAuditId', '') == existing().get('archiveAuditId', '')
        && isValidProject(incoming())
        && (incoming().get('customerMaterialIds', []) == existing().get('customerMaterialIds', [])
          || (incoming().customerMaterialIds is list
            && incoming().customerMaterialIds.hasAll(existing().get('customerMaterialIds', []))
            && existing().status != 'Concluída'
            && incoming().scheduleRevision == existing().get('scheduleRevision', 0) + 1))
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && incoming().get('contractPdf', null) == existing().get('contractPdf', null)
        && (existing().get('planningStatus', '') != 'Cronograma criado'
          || incoming().get('baselineEndDate', null) == existing().get('baselineEndDate', null))
        && (existing().status != 'Concluída' || (incoming().status == 'Concluída'
          && incoming().get('closureDate', '') == existing().get('closureDate', '')
          && incoming().get('warrantyStartDate', '') == existing().get('warrantyStartDate', '')))
        && (incoming().status != 'Concluída' || existing().status == 'Concluída' || (
          isValidNonEmptyStr(incoming().closureDate, 10) && incoming().closureDate == incoming().warrantyStartDate
          && getAfter(/databases/$(database)/documents/projectClosures/$(projectId)).data.date == incoming().closureDate
          && getAfter(/databases/$(database)/documents/projectFollowUps/$(projectId)).data.ownerUid == request.auth.uid
        ));
      allow update: if isValidId(projectId) && isOwner(existing().ownerUid) && existing().status != 'Concluída'
        && archivalChange('projects', projectId);
      allow delete: if false;
    }

    function installmentProjectBelongsToCompany(projectId) {
      let project = getAfter(/databases/$(database)/documents/projects/$(projectId));
      return project != null && project.data.ownerUid == request.auth.uid;
    }

    function validInstallmentReminder(installmentId, before, after) {
      let id = after.reminderMessageId;
      let send = getAfter(/databases/$(database)/documents/clients/$(before.clientId)/whatsappHistory/$(id)).data;
      return before.status == 'A vencer' && after.reminderSentAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['reminderMessageId', 'reminderSentAt', 'updatedAt', 'updatedBy'])
        && isValidId(id) && isValidActor(after.updatedBy) && after.updatedAt == request.time
        && send.ownerUid == request.auth.uid && send.createdAt == request.time && send.createdBy == after.updatedBy
        && send.projectId == before.projectId && send.sourceId == installmentId && isInstallmentWhatsAppModel(send.model);
    }

    match /parcelas/{installmentId} {
      allow get: if isValidId(installmentId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(installmentId) && isSignedIn() && isValidInstallment(incoming())
        && validNewReference(incoming(), 'clients', 'clientId')
        && validNewReference(incoming(), 'quotes', 'quoteId')
        && !incoming().keys().hasAny(['receiptReversalAuditId', 'reminderMessageId', 'reminderSentAt'])
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && installmentProjectBelongsToCompany(incoming().projectId);
      allow update: if isValidId(installmentId) && isSignedIn() && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().projectId == existing().projectId
        && incoming().quoteId == existing().quoteId
        && incoming().clientId == existing().clientId
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && (existing().status == 'Recebida' && incoming().status == 'A vencer'
          ? receiptRestoration(installmentId)
          : !incoming().diff(existing()).affectedKeys().hasAny(['reminderMessageId', 'reminderSentAt'])
            && isValidInstallment(incoming()) && incoming().get('receiptReversalAuditId', '') == existing().get('receiptReversalAuditId', '')
            && (existing().status != 'Recebida' || incoming().diff(existing()).affectedKeys().hasOnly([
              'invoiceStatus', 'updatedBy', 'updatedAt'
            ])));
      allow update: if isValidId(installmentId) && isOwner(existing().ownerUid)
        && incoming().get('reminderSentAt', null) == request.time
        && validInstallmentReminder(installmentId, existing(), incoming());
      allow delete: if false;
    }

    function isValidScheduleBaseline(data) {
      return data.keys().hasOnly([
        'ownerUid', 'projectId', 'version', 'recordedDate', 'endDate', 'justification', 'stages',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && hasAuditFields(data)
        && isValidId(data.projectId)
        && data.version is int && data.version >= 1
        && isValidNonEmptyStr(data.recordedDate, 10) && isValidNonEmptyStr(data.endDate, 10)
        && isValidStr(data.justification, 500)
        && (data.version == 1 || !data.justification.matches('^\\s*$'))
        && data.stages is list && data.stages.size() > 0;
    }

    function isValidScheduleProgress(data) {
      return data.keys().hasOnly([
        'ownerUid', 'projectId', 'scheduleRevision', 'date', 'progressPct',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && hasAuditFields(data)
        && isValidId(data.projectId)
        && data.scheduleRevision is int && data.scheduleRevision >= 1
        && isValidNonEmptyStr(data.date, 10)
        && isValidNonNegNum(data.progressPct) && data.progressPct <= 100;
    }

    match /baselines/{baselineId} {
      allow get: if isValidId(baselineId) && isOwner(existing().ownerUid);
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isValidId(baselineId) && isSignedIn() && isValidScheduleBaseline(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /scheduleProgress/{progressId} {
      allow get: if isValidId(progressId) && isOwner(existing().ownerUid);
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isValidId(progressId) && isSignedIn() && isValidScheduleProgress(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    function isValidProjectRisk(data) {
      return data.keys().hasOnly([
        'ownerUid', 'projectId', 'stageId', 'category', 'description', 'impact', 'status',
        'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
      ])
        && hasAuditFields(data)
        && isValidId(data.projectId) && isValidId(data.stageId)
        && data.category in ['Chuva', 'Material do cliente', 'Equipe', 'Retrabalho', 'Projeto', 'Dependência', 'Outros']
        && isValidNonEmptyStr(data.description, 500) && !data.description.matches('^\\s*$')
        && data.impact in ['Baixo', 'Médio', 'Alto']
        && data.status in ['Aberto', 'Monitorado', 'Resolvido']
        && get(/databases/$(database)/documents/stages/$(data.stageId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/stages/$(data.stageId)).data.projectId == data.projectId;
    }

    match /projectRisks/{riskId} {
      allow get: if isValidId(riskId) && isOwner(existing().ownerUid);
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isValidId(riskId) && isSignedIn() && isValidProjectRisk(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(riskId) && isOwner(existing().ownerUid) && isValidProjectRisk(incoming())
        && validChangedReference('projects', 'projectId')
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
    }

    function validMaterialDate(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validCustomerMaterial(data) {
      return data.keys().hasAll([
        'ownerUid', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'projectId', 'stageId', 'auditId',
        'description', 'quantity', 'unit', 'leadDays', 'promisedDate', 'deliveredDate', 'status', 'clientContact', 'notes'
      ])
        && data.keys().hasOnly([
          'ownerUid', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'projectId', 'stageId', 'auditId',
          'description', 'quantity', 'unit', 'leadDays', 'promisedDate', 'deliveredDate', 'status', 'clientContact', 'notes', 'templateKey'
        ])
        && hasAuditFields(data) && isValidId(data.projectId) && isValidId(data.stageId) && isValidId(data.auditId)
        && isValidNonEmptyStr(data.description, 160)
        && (data.quantity == null || (isValidNum(data.quantity) && data.quantity > 0))
        && isValidStr(data.unit, 24) && data.leadDays is int && data.leadDays >= 0 && data.leadDays <= 3650
        && data.status in ['A comprar', 'Comprado', 'Em transporte', 'Entregue']
        && validMaterialDate(data.promisedDate) && validMaterialDate(data.deliveredDate)
        && (data.status == 'Entregue' ? data.deliveredDate != '' : data.deliveredDate == '')
        && isValidStr(data.clientContact, 140) && isValidStr(data.notes, 600)
        && (!('templateKey' in data) || isValidId(data.templateKey));
    }

    function validMaterialMutation(materialId, data, action, previousStage) {
      let project = getAfter(/databases/$(database)/documents/projects/$(data.projectId)).data;
      let stage = getAfter(/databases/$(database)/documents/stages/$(data.stageId)).data;
      let audit = getAfter(/databases/$(database)/documents/auditLogs/$(data.auditId)).data;
      return project.ownerUid == request.auth.uid && project.status != 'Concluída' && !('archive' in project)
        && project.updatedAt == request.time && project.customerMaterialIds.hasAny([materialId])
        && stage.ownerUid == request.auth.uid && stage.projectId == data.projectId
        && (stage.status != 'Concluída' || previousStage == data.stageId)
        && audit.ownerUid == request.auth.uid && audit.createdAt == request.time
        && audit.entityType == 'customerMaterials' && audit.entityId == materialId && audit.action == action
        && audit.registeredBy == data.updatedBy && isValidNonEmptyStr(audit.afterValue, 500);
    }

    match /customerMaterials/{materialId} {
      allow get: if isValidId(materialId) && isOwner(existing().ownerUid);
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isValidId(materialId) && isSignedIn() && validCustomerMaterial(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && validMaterialMutation(materialId, incoming(), 'Criação', '');
      allow update: if isValidId(materialId) && isOwner(existing().ownerUid) && validCustomerMaterial(incoming())
        && incoming().projectId == existing().projectId && incoming().ownerUid == existing().ownerUid
        && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt
        && incoming().get('templateKey', '') == existing().get('templateKey', '')
        && incoming().updatedAt == request.time && validMaterialMutation(materialId, incoming(), 'Atualização', existing().stageId);
      allow delete: if false;
    }

    match /stages/{stageId} {
      allow get: if isValidId(stageId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(stageId) && isSignedIn() && isValidStage(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerUid == request.auth.uid;
      allow update: if isValidId(stageId) && isSignedIn() && isValidStage(incoming())
        && validChangedReference('projects', 'projectId')
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && incoming().get('baselineStartWeek', null) == existing().get('baselineStartWeek', incoming().get('baselineStartWeek', null))
        && incoming().get('baselineDurationWeeks', null) == existing().get('baselineDurationWeeks', incoming().get('baselineDurationWeeks', null))
        && incoming().get('baselineBudgetedCost', null) == existing().get('baselineBudgetedCost', incoming().get('baselineBudgetedCost', null));
      allow delete: if isValidId(stageId) && isSignedIn() && existing().ownerUid == request.auth.uid;
    }

    match /dailyLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid);
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(logId) && isSignedIn() && isValidDailyLog(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerUid == request.auth.uid;
      allow update: if isValidId(logId) && isSignedIn() && isValidDailyLog(incoming())
        && validChangedReference('projects', 'projectId')
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(logId) && isSignedIn() && existing().ownerUid == request.auth.uid;

      match /photos/{photoId} {
        allow get: if isValidId(photoId) && isOwner(existing().ownerUid)
          && get(/databases/$(database)/documents/dailyLogs/$(logId)).data.ownerUid == request.auth.uid;
        allow create: if isValidId(photoId) && isSignedIn()
          && incoming().keys().hasOnly(['ownerUid', 'mimeType', 'content', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
          && hasAuditFields(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time
          && incoming().mimeType == 'image/jpeg' && incoming().content is bytes
          && incoming().content.size() > 0 && incoming().content.size() <= 393216
          && getAfter(/databases/$(database)/documents/dailyLogs/$(logId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/dailyLogs/$(logId)).data.photoBackend == 'firestore'
          && photoId in getAfter(/databases/$(database)/documents/dailyLogs/$(logId)).data.photoIds;
      }
    }

    match /fieldSync/{operationId} {
      allow get: if isValidId(operationId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid);
      allow create: if isValidId(operationId) && isSignedIn()
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().keys().hasOnly(['ownerUid', 'projectId', 'stageId', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && hasAuditFields(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && isValidId(incoming().projectId) && isValidId(incoming().stageId)
        && getAfter(/databases/$(database)/documents/stages/$(incoming().stageId)).data.projectId == incoming().projectId
        && getAfter(/databases/$(database)/documents/stages/$(incoming().stageId)).data.ownerUid == request.auth.uid;
    }

    function isReversalReason(value) {
      return isValidNonEmptyStr(value, 200) && value.trim().size() > 0;
    }

    function hasReversalFields(data) {
      return data.status in ['Estorno', 'Estornado']
        || data.keys().hasAny(['reversalId', 'reversalOfId', 'reversalReason', 'reversalAuditId']);
    }

    function receiptRestoration(installmentId) {
      let auditId = incoming().get('receiptReversalAuditId', '');
      let linked = existing().get('transactionId', '');
      return existing().status == 'Recebida' && incoming().status == 'A vencer'
        && incoming().receivedDate == '' && incoming().transactionId == ''
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'receivedDate', 'transactionId', 'receiptReversalAuditId', 'updatedAt', 'updatedBy'
        ])
        && isValidId(auditId) && currentAudit(auditId, 'parcelas', installmentId, incoming().updatedBy)
        && isReversalReason(getAfter(/databases/$(database)/documents/auditLogs/$(auditId)).data.afterValue)
        && (linked == '' || (
          get(/databases/$(database)/documents/transactions/$(linked)).data.status == 'Recebido'
          && getAfter(/databases/$(database)/documents/transactions/$(linked)).data.status == 'Estornado'
          && getAfter(/databases/$(database)/documents/transactions/$(linked)).data.reversalAuditId == auditId
        ));
    }

    function undoneReceiptMatches(installmentId, originalId, before, auditId) {
      let parcel = get(/databases/$(database)/documents/parcelas/$(installmentId)).data;
      let restored = getAfter(/databases/$(database)/documents/parcelas/$(installmentId)).data;
      return parcel.ownerUid == request.auth.uid && parcel.status == 'Recebida' && parcel.transactionId == originalId
        && before.status == 'Recebido' && before.entryKind == 'income' && before.isForecast == false
        && before.projectId == parcel.projectId && before.get('installmentId', '') in ['', installmentId]
        && restored.status == 'A vencer' && restored.receiptReversalAuditId == auditId;
    }

    function reversedDebtMatches(debtId, originalId, before) {
      let debt = get(/databases/$(database)/documents/debts/$(debtId)).data;
      let after = getAfter(/databases/$(database)/documents/debts/$(debtId)).data;
      let unmodified = debtId == 'debt-' + originalId && debt.status == 'Em uso' && debt.principalBalance == before.amount;
      return debt.ownerUid == request.auth.uid && (unmodified
        ? after.status == 'Quitada' && after.principalBalance == 0 && after.updatedAt == request.time
        : after == debt);
    }

    function validReversalUpdate(originalId, before, after) {
      let inverseId = after.get('reversalId', '');
      let auditId = after.get('reversalAuditId', '');
      let inverse = getAfter(/databases/$(database)/documents/transactions/$(inverseId)).data;
      let audit = getAfter(/databases/$(database)/documents/auditLogs/$(auditId)).data;
      let debtId = before.get('debtId', '');
      return !hasReversalFields(before) && after.status == 'Estornado' && isValidActor(after.updatedBy)
        && after.diff(before).affectedKeys().hasOnly(['status', 'reversalId', 'reversalAuditId', 'reversalReason', 'updatedBy', 'updatedAt'])
        && isValidId(inverseId) && isValidId(auditId)
        && isReversalReason(after.reversalReason) && audit.afterValue == after.reversalReason
        && inverse.status == 'Estorno' && inverse.reversalOfId == originalId && inverse.reversalAuditId == auditId
        && inverse.createdAt == request.time
        && (debtId == '' || reversedDebtMatches(debtId, originalId, before))
        && ((audit.entityType == 'transactions' && before.get('installmentId', '') == ''
          && currentAudit(auditId, 'transactions', originalId, after.updatedBy))
          || (audit.entityType == 'parcelas' && isValidId(audit.entityId)
            && currentAudit(auditId, 'parcelas', audit.entityId, after.updatedBy)
            && undoneReceiptMatches(audit.entityId, originalId, before, auditId)));
    }

    function validInverse(txId, data) {
      let originalId = data.get('reversalOfId', '');
      let before = get(/databases/$(database)/documents/transactions/$(originalId)).data;
      let after = getAfter(/databases/$(database)/documents/transactions/$(originalId)).data;
      return data.status == 'Estorno' && isValidId(originalId) && isValidId(data.reversalAuditId)
        && hasAuditFields(data) && isValidNonEmptyStr(data.description, 200)
        && data.keys().hasOnly([
          'ownerUid', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
          'date', 'dueDate', 'description', 'entryKind', 'category', 'projectId', 'projectName',
          'amount', 'isForecast', 'status', 'invoiceStatus', 'paymentMethod', 'reversalOfId', 'reversalAuditId'
        ])
        && before.ownerUid == request.auth.uid && !hasReversalFields(before)
        && after.status == 'Estornado' && after.reversalId == txId && after.reversalAuditId == data.reversalAuditId
        && after.updatedAt == request.time && data.createdBy == after.updatedBy && data.updatedBy == after.updatedBy
        && data.amount == before.amount && data.entryKind == before.entryKind
        && data.projectId == before.projectId && data.category == before.category
        && data.date == before.date && data.isForecast == before.isForecast
        && data.dueDate == (before.get('dueDate', '') == '' ? before.date : before.dueDate)
        && data.projectName == before.get('projectName', '') && data.paymentMethod == before.get('paymentMethod', '')
        && data.invoiceStatus == 'Não se aplica';
    }

    match /transactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(txId) && isSignedIn()
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (incoming().status == 'Estorno'
          ? validInverse(txId, incoming())
          : isValidTransaction(incoming()) && !hasReversalFields(incoming())
            && validNewReference(incoming(), 'projects', 'projectId')
            && validNewReference(incoming(), 'quotes', 'quoteId')
            && validNewReference(incoming(), 'employees', 'payrollEmployeeId'));
      allow update: if isValidId(txId) && isOwner(existing().ownerUid)
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && (incoming().status == 'Estornado'
          ? validReversalUpdate(txId, existing(), incoming())
          : !hasReversalFields(existing()) && !hasReversalFields(incoming())
            && (existing().isForecast || incoming().diff(existing()).affectedKeys().hasOnly(['invoiceStatus', 'updatedBy', 'updatedAt']))
            && isValidTransaction(incoming())
            && validChangedReference('projects', 'projectId')
            && validChangedReference('quotes', 'quoteId')
            && validChangedReference('employees', 'payrollEmployeeId'));
      allow delete: if false;
    }

    match /debts/{debtId} {
      allow get: if isValidId(debtId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(debtId) && isSignedIn() && isValidDebt(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(debtId) && isSignedIn() && isValidDebt(incoming())
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(debtId) && isSignedIn() && existing().ownerUid == request.auth.uid;
    }

    match /employees/{employeeId} {
      allow get: if isValidId(employeeId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(employeeId) && isSignedIn() && isValidEmployee(incoming())
        && notDeleted('employees', employeeId)
        && validNewReference(incoming(), 'projects', 'currentProjectId')
        && !incoming().keys().hasAny(['archive', 'archiveAuditId']) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(employeeId) && isSignedIn()
        && validChangedReference('projects', 'currentProjectId')
        && existing().ownerUid == request.auth.uid
        && !('archive' in existing()) && !('archive' in incoming())
        && incoming().get('archiveAuditId', '') == existing().get('archiveAuditId', '')
        && isValidEmployee(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow update: if isValidId(employeeId) && isOwner(existing().ownerUid)
        && archivalChange('employees', employeeId);
      allow delete: if false;
    }

    match /employees/{employeeId}/occurrences/{occurrenceId} {
      allow get: if isOwner(existing().ownerUid);
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isSignedIn() && isValidId(occurrenceId)
        && get(/databases/$(database)/documents/employees/$(employeeId)).data.ownerUid == request.auth.uid
        && incoming().keys().hasOnly(['ownerUid', 'kind', 'date', 'description', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && hasAuditFields(incoming())
        && incoming().kind in ['Elogio', 'Registro', 'Advertência', 'Acidente', 'Quase acidente']
        && isValidNonEmptyStr(incoming().date, 10)
        && isValidNonEmptyStr(incoming().description, 1000)
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
    }

    match /allocations/{allocationId} {
      allow get: if isValidId(allocationId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid);
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(allocationId) && isSignedIn() && isValidAllocation(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && validNewReference(incoming(), 'employees', 'employeeId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(incoming().employeeId))
        && get(/databases/$(database)/documents/employees/$(incoming().employeeId)).data.ownerUid == request.auth.uid;
      allow update: if isValidId(allocationId) && isSignedIn() && isValidAllocation(incoming())
        && validChangedReference('projects', 'projectId')
        && validChangedReference('employees', 'employeeId')
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().employeeId == existing().employeeId
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(allocationId) && isSignedIn() && existing().ownerUid == request.auth.uid;
    }

    match /pops/{popId} {
      allow get: if isValidId(popId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(popId) && isSignedIn() && isValidPop(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(popId) && isSignedIn() && isValidPop(incoming())
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(popId) && isOwner(existing().ownerUid) && !('publicationNumber' in existing());
    }


    match /popVersions/{versionId} {
      allow get: if isOwner(existing().ownerUid);
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isValidId(versionId) && isSignedIn() && hasAuditFields(incoming())
        && incoming().keys().hasOnly(['ownerUid', 'popId', 'version', 'publicationNumber', 'title', 'serviceType',
          'linkedStagePhase', 'objective', 'materialsAndEpi', 'tools', 'protectiveEquipment', 'steps', 'acceptanceCriteria',
          'usedInOnboarding', 'attachments', 'approvedBy', 'publishedOn', 'changeSummary',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && hasPopContent(incoming()) && hasPopApproval(incoming())
        && isValidId(incoming().popId) && isValidNonEmptyStr(incoming().version, 20)
        && incoming().publicationNumber is int && incoming().publicationNumber > 0
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/pops/$(incoming().popId)).data.ownerUid == request.auth.uid;
    }

    match /popMediaChunks/{chunkId} {
      allow get: if isValidId(chunkId) && isOwner(existing().ownerUid);
      allow create: if isValidId(chunkId) && isSignedIn() && hasAuditFields(incoming())
        && incoming().keys().hasOnly(['ownerUid', 'popId', 'attachmentId', 'index', 'content',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && isValidId(incoming().popId) && isValidId(incoming().attachmentId)
        && incoming().index is int && incoming().index >= 0 && incoming().index < 8
        && incoming().content is bytes && incoming().content.size() > 0 && incoming().content.size() <= 655360
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/pops/$(incoming().popId)).data.ownerUid == request.auth.uid;
    }

    match /complianceItems/{itemId} {
      allow get: if isValidId(itemId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(itemId) && isSignedIn() && isValidComplianceItem(incoming(), itemId)
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(itemId) && isSignedIn() && isValidComplianceItem(incoming(), itemId)
        && validChangedReference('projects', 'projectId')
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(itemId) && isSignedIn() && existing().ownerUid == request.auth.uid;
    }

    match /complianceFiles/{attachmentId} {
      // Legacy bytes remain readable while the storage migration is in progress.
      allow get: if isValidId(attachmentId) && isOwner(existing().ownerUid);
      allow list, write: if false;
    }

    match /tenders/{tenderId} {
      allow get: if isValidId(tenderId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(tenderId) && isSignedIn() && isValidTender(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(tenderId) && isSignedIn() && isValidTender(incoming())
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(tenderId) && isSignedIn() && existing().ownerUid == request.auth.uid;
    }

    match /projectClosures/{projectId} {
      allow get: if isOwner(existing().ownerUid);
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isValidId(projectId) && isSignedIn() && hasAuditFields(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().keys().hasOnly(['ownerUid', 'projectId', 'date', 'dre', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && incoming().projectId == projectId && isValidNonEmptyStr(incoming().date, 10)
        && incoming().dre is map && incoming().dre.obraId == projectId
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.status == 'Concluída'
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.closureDate == incoming().date;
    }

    function validFollowUp(data, projectId) {
      return hasAuditFields(data) && data.projectId == projectId
        && data.keys().hasOnly(['ownerUid', 'projectId', 'testimonialRequestedAt', 'referralRequestedAt',
          'testimonial', 'referrals', 'marketingPhotos', 'authorizationNote', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && isValidStr(data.testimonialRequestedAt, 10) && isValidStr(data.referralRequestedAt, 10)
        && isValidStr(data.testimonial, 3000) && isValidStr(data.referrals, 2000) && isValidStr(data.authorizationNote, 500)
        && data.marketingPhotos is list && data.marketingPhotos.size() <= 100
        && (data.marketingPhotos.size() == 0 || !data.authorizationNote.matches('^\\s*$'))
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.status == 'Concluída';
    }

    match /projectFollowUps/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (resource == null || isOwner(existing().ownerUid));
      allow list: if isBoundedList() && isOwner(existing().ownerUid);
      allow create: if isValidId(projectId) && isSignedIn() && validFollowUp(incoming(), projectId)
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId) && isOwner(existing().ownerUid) && validFollowUp(incoming(), projectId)
        && validChangedReference('projects', 'projectId')
        && incoming().createdAt == existing().createdAt && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
    }

    match /warrantyCalls/{callId} {
      allow get: if isValidId(callId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(callId) && isSignedIn() && isValidWarrantyCall(incoming())
        && validNewReference(incoming(), 'projects', 'projectId')
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.status == 'Concluída'
        && isValidNonEmptyStr(incoming().openedDate, 10)
        && isValidNonEmptyStr(incoming().deadlineDate, 10)
        && isValidNonEmptyStr(get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.warrantyStartDate, 10);
      allow update: if isValidId(callId) && isSignedIn() && isValidWarrantyCall(incoming())
        && validChangedReference('projects', 'projectId')
        && existing().ownerUid == request.auth.uid
        && incoming().ownerUid == existing().ownerUid
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(callId) && isSignedIn() && existing().ownerUid == request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow list: if isBoundedList() && isSignedIn() && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(logId) && isSignedIn() && isValidAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
